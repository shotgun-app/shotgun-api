# Optional. Docker Compose works without a .env file, copy this to .env to change a setting.

# Port the API is published on (the frontend expects 8080)
API_PORT=8080

# CORS: origin of the web app (Vite dev server by default)
ALLOWED_ORIGIN=http://localhost:5173

# Database credentials (avoid special characters like @ or / in the password)
POSTGRES_USER=shotgun
POSTGRES_PASSWORD=shotgun
POSTGRES_DB=shotgun

# Port Postgres is published on. Change it (e.g. 5433) if a local Postgres already uses 5432
DB_PORT=5432

# Session cookie: set COOKIE_SECURE=true when the API is served over HTTPS
COOKIE_SECURE=false
# How long a login lasts, in hours (720 = 30 days)
SESSION_TTL_HOURS=720
