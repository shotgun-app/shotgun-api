# Optional. Docker Compose works without a .env file, copy this to .env to change a setting.

# Port the API is published on (the frontend expects 8080)
API_PORT=8080

# CORS: origin of the web app (Vite dev server by default)
ALLOWED_ORIGIN=http://localhost:5173

# Database credentials (avoid special characters like @ or / in the password)
POSTGRES_USER=shotgun
POSTGRES_PASSWORD=shotgun
POSTGRES_DB=shotgun
